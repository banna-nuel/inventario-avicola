# Variables del servicio "db" (MySQL 8.4) de la pila Docker. Es la plantilla, sin secretos.
#
# El archivo real es .env.docker.db (no va a Git). Lo crea scripts/docker-init.ps1 junto con
# .env.docker.app, con la misma contraseña en los dos.
# Formato: CLAVE=valor, una por línea, sin espacios alrededor del "=".
#
# MySQL usa estas variables solo la primera vez, con el volumen vacío: crea la base y el usuario.
# Cambiarlas después no cambia una base ya creada (docs/docker.md, "Borrar los datos").

MYSQL_DATABASE=inventario_avicola
# Usuario de la app: solo tiene permisos sobre MYSQL_DATABASE
MYSQL_USER=inventario
# La misma que DB_PASSWORD de .env.docker.app (la genera el script)
MYSQL_PASSWORD=
# La contraseña de root se genera al azar y aparece una sola vez en "docker compose logs db".
# La app no la usa (docs/docker.md, "La contraseña de root de MySQL").
MYSQL_RANDOM_ROOT_PASSWORD=yes
