# Variables de la pila Docker (compose.yaml). Es la plantilla: cópiala como .env.docker y
# completa APP_KEY y las dos contraseñas (docs/docker.md, "Primera vez").
# .env.docker no va a Git (.gitignore); este .example sí, y nunca lleva valores reales.
#
# Lo leen dos servicios: app (las variables de Laravel) y db (las MYSQL_*).
# Formato: CLAVE=valor, una por línea, sin espacios alrededor del "=".

# --- Laravel (servicio app) ------------------------------------------------------------------
APP_NAME="Inventario Avícola"
APP_ENV=production
# Clave de cifrado de sesiones y cookies. Se genera con:
#   docker compose run --rm --no-deps app php artisan key:generate --show
# Nunca se guarda en la imagen; sin ella la app no arranca.
APP_KEY=
# Siempre false aquí: con true, un error muestra código y datos internos
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logs a la salida de error del contenedor: se ven con "docker compose logs app"
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Conexión con el servicio db (el nombre del servicio funciona como nombre de equipo)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=inventario_avicola
DB_USERNAME=inventario
# La misma contraseña que MYSQL_PASSWORD (más abajo)
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# false solo porque esta pila sirve HTTP local (127.0.0.1:8080). Con HTTPS va en true: la
# cookie de sesión solo viaja cifrada.
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# --- MySQL (servicio db) ---------------------------------------------------------------------
# MySQL crea la base y el usuario la primera vez, con el volumen vacío. Cambiarlos después no
# cambia una base ya creada (docs/docker.md, "Borrar los datos").
MYSQL_DATABASE=inventario_avicola
MYSQL_USER=inventario
# La misma que DB_PASSWORD. Se genera con:
#   docker compose run --rm --no-deps app php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
MYSQL_PASSWORD=
# La contraseña de root se genera al azar en la primera inicialización (aparece una sola vez en
# "docker compose logs db"). La app no la usa: entra con MYSQL_USER, que solo tiene permisos
# sobre MYSQL_DATABASE.
MYSQL_RANDOM_ROOT_PASSWORD=yes
