# Variables del servicio "app" (Laravel) de la pila Docker. Es la plantilla, sin secretos.
#
# El archivo real es .env.docker.app (no va a Git). Créalo junto con .env.docker.db, con la
# clave y la contraseña ya generadas, con:
#   powershell -ExecutionPolicy Bypass -File scripts\docker-init.ps1
# Formato: CLAVE=valor, una por línea, sin espacios alrededor del "=".

APP_NAME="Inventario Avícola"
APP_ENV=production
# Clave de cifrado de sesiones y cookies (la genera scripts/docker-init.ps1). Nunca va en la imagen;
# sin ella la app no arranca.
APP_KEY=
# Siempre false aquí: con true, un error muestra código y datos internos
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logs a la salida de error del contenedor: se ven con "docker compose logs app"
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Conexión con el servicio db (el nombre del servicio funciona como nombre de equipo).
# DB_DATABASE, DB_USERNAME y DB_PASSWORD tienen que coincidir con MYSQL_DATABASE, MYSQL_USER y
# MYSQL_PASSWORD de .env.docker.db (el script los deja iguales).
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=inventario_avicola
DB_USERNAME=inventario
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# false solo porque esta pila sirve HTTP local (127.0.0.1:8080). Con HTTPS va en true: la
# cookie de sesión solo viaja cifrada.
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
