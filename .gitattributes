* text=auto eol=lf

# Docker: lo que se copia a las imágenes (Linux) siempre con finales de línea LF, aunque se
# edite en Windows. Un script .sh con CRLF no se puede ejecutar ("/bin/sh^M: not found").
*.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
compose.yaml text eol=lf
docker/** text eol=lf
*.conf text eol=lf
*.ini text eol=lf
.env.docker.example text eol=lf
artisan text eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
